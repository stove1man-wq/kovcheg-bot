# Скопируйте в файл .env (он в .gitignore и в репозиторий не попадает) и впишите свои значения.
BOT_TOKEN=токен-от-BotFather
# Ваш числовой Telegram-id (узнать: бот @userinfobot): даёт доступ к /stats и /apps
ADMIN_ID=0
# Ссылка на политику обработки персональных данных (страница на сайте)
POLICY_URL=
# Ссылка-приглашение в чат тестировщиков (когда будет)
TESTERS_URL=
DB_PATH=bot.db
# Почта для заявок (необязательно: без неё заявки хранятся в базе и видны по /apps)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=
MAIL_FROM=
